{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "commit-search-depth": 9007199254740991,
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "plugin",
      "version-file": "VERSION",
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "draft": true,
      "prerelease": true,
      "extra-files": ["lua/louiselm/version.lua"],
      "exclude-paths": [
        ".beads", ".agents", ".claude", ".codex", ".grok", ".playwright-cli",
        "capture-service", "skills-core", "android", "contrib", "infra",
        "blog", "site", "demo", "assets"
      ]
    },
    "capture-service": {
      "release-type": "rust",
      "component": "capture",
      "initial-version": "0.1.0",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "draft": true,
      "prerelease": true
    }
  }
}
