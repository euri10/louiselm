#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
deps_dir="$repo_root/.deps"
mini_dir="$deps_dir/mini.nvim"
mini_url="https://github.com/nvim-mini/mini.nvim.git"
mini_revision="1345d191bb3da9c7b0e977f4387c5761f9bff68d"

if [ -e "$mini_dir" ] && [ ! -d "$mini_dir/.git" ]; then
	echo "error: $mini_dir exists but is not a git checkout" >&2
	exit 1
fi

mkdir -p "$deps_dir"
if [ ! -d "$mini_dir" ]; then
	echo "Installing mini.nvim $mini_revision"
	git clone --filter=blob:none --no-checkout "$mini_url" "$mini_dir"
fi

if ! git -C "$mini_dir" cat-file -e "$mini_revision^{commit}" 2>/dev/null; then
	git -C "$mini_dir" fetch --depth 1 origin "$mini_revision"
fi
git -C "$mini_dir" checkout --detach "$mini_revision" >/dev/null

actual_revision=$(git -C "$mini_dir" rev-parse HEAD)
if [ "$actual_revision" != "$mini_revision" ]; then
	echo "error: expected mini.nvim $mini_revision, got $actual_revision" >&2
	exit 1
fi

echo "mini.test installed at $mini_dir ($actual_revision)"
