#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
deps_dir="$repo_root/.deps"
mini_revision="1345d191bb3da9c7b0e977f4387c5761f9bff68d"
snacks_revision="882c996cf28183f4d63640de0b4c02ec886d01f2"

install_plugin() (
	name=$1
	revision=$2
	url=$3
	destination="$deps_dir/$name"
	if [ -e "$destination" ] && [ ! -d "$destination/.git" ]; then
		echo "error: $destination exists but is not a git checkout" >&2
		exit 1
	fi

	mkdir -p "$deps_dir"
	if [ ! -d "$destination" ]; then
		echo "Installing $name $revision"
		git clone --filter=blob:none --no-checkout "$url" "$destination"
	fi

	if ! git -C "$destination" cat-file -e "$revision^{commit}" 2>/dev/null; then
		git -C "$destination" fetch --depth 1 origin "$revision"
	fi
	git -C "$destination" checkout --detach "$revision" >/dev/null

	actual_revision=$(git -C "$destination" rev-parse HEAD)
	if [ "$actual_revision" != "$revision" ]; then
		echo "error: expected $name $revision, got $actual_revision" >&2
		exit 1
	fi
	echo "$name installed at $destination ($actual_revision)"
)

install_plugin mini.nvim "$mini_revision" https://github.com/nvim-mini/mini.nvim.git
install_plugin snacks.nvim "$snacks_revision" https://github.com/folke/snacks.nvim.git
