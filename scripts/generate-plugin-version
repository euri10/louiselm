#!/usr/bin/env python3
"""Project VERSION into the committed, side-effect-free Lua module."""

import argparse
import json
from pathlib import Path
import re


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    version = (root / "VERSION").read_text().strip()
    if not re.fullmatch(r"0\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)", version):
        parser.error("VERSION must be 0.x.y; 1.0 requires an explicit stability decision")
    manifest = json.loads((root / ".release-please-manifest.json").read_text())
    if manifest.get(".") != version:
        parser.error("VERSION and the plugin release manifest disagree")
    output = (
        "-- Generated by scripts/generate-plugin-version; do not edit.\n"
        f'return {{ version = "{version}" }} -- x-release-please-version\n'
    )
    target = root / "lua/louiselm/version.lua"
    if args.check:
        if not target.exists() or target.read_text() != output:
            parser.error("lua/louiselm/version.lua is stale; run ./scripts/generate-plugin-version")
    else:
        target.write_text(output)


if __name__ == "__main__":
    main()
