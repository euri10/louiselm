#!/usr/bin/env bash
# Emit an offline reservation snapshot describing which agent sessions are
# still alive, so `br coordination status` can tell an abandoned claim from a
# working one.
#
# Beads refuses to release a claim it cannot assess. Without a snapshot every
# claim classifies as `no_mail_snapshot` forever, at any age, which is why a
# session that dies mid-task takes its issue out of the queue permanently.
# Agent Mail is the upstream answer to that; this is the same evidence taken
# from files the machine already writes.
#
# A session's heartbeat is the mtime of its transcript. A live session gets a
# reservation that has not expired, and br protects its claim. A dead session
# gets an expired one, and br considers both issue and transcript age. An
# assignee with no transcript gets no row and is named on stderr; --status
# keeps such owners unknown and therefore protected.
set -euo pipefail

window_minutes=${LOUISELM_LIVENESS_WINDOW_MINUTES:-45}

usage() {
	cat >&2 <<'USAGE'
usage: agent-liveness-snapshot [--status [br args...]]

  (no arguments)  Write reservation snapshot JSONL to stdout. Assignees are
                  read from stdin, one per line, or from `br list` when stdin
                  is a terminal or contains no non-whitespace input.
  --status        Generate reservation and agent snapshots for `br coordination
                  status`, refusing empty evidence. Successful snapshots are
                  retained in a private temporary directory for guarded reclaim.
                  Regenerate immediately before reclaim; remove the printed
                  directory when finished. Remaining arguments pass through to br.

environment:
  LOUISELM_LIVENESS_WINDOW_MINUTES   Minutes of transcript silence before a
                                     session counts as gone (default 45).
USAGE
}

# Find the freshest transcript, or return empty when none exists.
heartbeat_path() {
	local id=$1
	local newest=""
	local newest_path=""
	local candidate

	# Every adapter driven through LouiseLM writes here, and it is the
	# freshest of the three because the proxy sees traffic in both
	# directions.
	candidate="$HOME/.local/state/acp-llm-adapter/proxy/sessions/$id/log.jsonl"
	if [ -f "$candidate" ]; then
		newest=$(stat -c %Y "$candidate")
		newest_path=$candidate
	fi

	# Adapters run outside LouiseLM only leave their own transcript.
	if [ -d "$HOME/.codex/sessions" ]; then
		while IFS= read -r found; do
			candidate=$(stat -c %Y "$found")
			if [ -z "$newest" ] || [ "$candidate" -gt "$newest" ]; then
				newest=$candidate
				newest_path=$found
			fi
		done < <(find "$HOME/.codex/sessions" -type f -name "*$id*" 2>/dev/null)
	fi

	if [ -d "$HOME/.claude/projects" ]; then
		while IFS= read -r found; do
			candidate=$(stat -c %Y "$found")
			if [ -z "$newest" ] || [ "$candidate" -gt "$newest" ]; then
				newest=$candidate
				newest_path=$found
			fi
		done < <(find "$HOME/.claude/projects" -type f -name "$id.jsonl" 2>/dev/null)
	fi

	printf '%s' "$newest_path"
}

emit_snapshot() {
	local assignees=$1
	local seen=""
	local reported=0
	local unresolved=0
	local holder id transcript last last_active expires

	while IFS= read -r holder; do
		holder=${holder#"${holder%%[![:space:]]*}"}
		holder=${holder%"${holder##*[![:space:]]}"}
		[ -n "$holder" ] || continue

		# One row per holder: the same session legitimately holds several
		# claims, and duplicate rows would just be re-matched per claim.
		case "$seen" in
		*"|$holder|"*) continue ;;
		esac
		seen="$seen|$holder|"

		# Assignees are `<agent>/<session-id>`; legacy rows are a bare id.
		id=${holder##*/}

		transcript=$(heartbeat_path "$id")
		if [ -z "$transcript" ]; then
			echo "agent-liveness-snapshot: no transcript found for $holder; treat its claim as live (unknown owner)" >&2
			unresolved=$((unresolved + 1))
			continue
		fi
		last=$(stat -c %Y "$transcript")
		last_active=$(date -u -d "@$last" +%Y-%m-%dT%H:%M:%SZ)

		# br treats the reservation as active while expires_ts is in the
		# future, so the window is expressed as an expiry on the last
		# heartbeat rather than as a separate age field.
		expires=$(date -u -d "@$((last + window_minutes * 60))" +%Y-%m-%dT%H:%M:%SZ)

		# `reason` is free text, but br also correlates a reservation to a
		# claim when reason contains the issue id, so it must never name one.
		# last_active_ts also feeds --agents: expiry alone forgets activity
		# after 45 minutes, whereas reclaim requires eight quiet hours.
		jq -cn --arg holder "$holder" --arg path "$transcript" \
			--arg expires "$expires" --arg last "$last_active" \
			'{holder:$holder, path_pattern:$path, exclusive:true, expires_ts:$expires,
			  reason:("transcript last written " + $last), last_active_ts:$last}'
		reported=$((reported + 1))
	done <<<"$assignees"

	echo "agent-liveness-snapshot: $reported session(s) reported, $unresolved unresolved, ${window_minutes}m window" >&2
}

read_assignees() {
	local assignees
	if [ ! -t 0 ]; then
		assignees=$(cat) || return
		if [[ "$assignees" =~ [^[:space:]] ]]; then
			printf '%s\n' "$assignees"
			return
		fi
	fi

	# Coordination includes assigned open/blocked/review claims too. br list
	# excludes terminal issues; pinned and deferred issues are not claims.
	br list --json | jq -r '.issues[] | select(.status != "pinned" and .status != "deferred") | .assignee // empty'
}

main() {
	local mode=emit

	if [ "${1-}" = "--help" ] || [ "${1-}" = "-h" ]; then
		usage
		exit 0
	fi

	if [ "${1-}" = "--status" ]; then
		mode=status
		shift
	fi

	local assignees
	# A command substitution can reuse closed fd 0 for its pipe and hang cat.
	if ! { : 3<&0; } 2>/dev/null; then
		echo "agent-liveness-snapshot: stdin is closed" >&2
		return 1
	fi
	assignees=$(read_assignees)

	if [ "$mode" = emit ]; then
		emit_snapshot "$assignees"
		return
	fi

	local snapshot_dir snapshot_file agents_file
	snapshot_dir=$(mktemp -d "${TMPDIR:-/tmp}/louiselm-liveness.XXXXXXXX")
	snapshot_file="$snapshot_dir/reservations.jsonl"
	agents_file="$snapshot_dir/agents.jsonl"
	# EXIT runs after main's locals are gone; bind the owned path now.
	trap "rm -f -- $(printf '%q' "$snapshot_file") $(printf '%q' "$agents_file"); rmdir -- $(printf '%q' "$snapshot_dir")" EXIT
	emit_snapshot "$assignees" >"$snapshot_file"
	if [ ! -s "$snapshot_file" ]; then
		echo "agent-liveness-snapshot: refusing coordination status with an empty snapshot" >&2
		return 1
	fi
	jq -c '{name:.holder, task_description:"LouiseLM transcript liveness", last_active_ts, contact_policy:"auto"}' \
		"$snapshot_file" >"$agents_file"
	# Only holders with real transcripts become known swarm agents. Omitted
	# or unresolved holders remain protected even in a partial stdin snapshot.
	br coordination status --reservations "$snapshot_file" --agents "$agents_file" --owner-kind unknown "$@"
	trap - EXIT
	echo "agent-liveness-snapshot: evidence retained in $snapshot_dir; regenerate immediately before reclaim, remove when finished" >&2
}

main "$@"
