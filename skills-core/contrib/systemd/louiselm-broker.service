[Unit]
Description=LouiseLM Control broker
Requires=louiselm-broker.socket
After=louiselm-broker.socket

[Service]
Type=exec
User=louiselm-broker
Group=louiselm-broker
StateDirectory=louiselm/broker
StateDirectoryMode=0700
RuntimeDirectory=louiselm-operator
RuntimeDirectoryMode=0755
UMask=0077
# Pass the sole listener through a safely borrowable standard descriptor.
StandardInput=socket
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/lib/louiselm/current/bin/louiselm-control serve
Restart=on-failure
RestartSec=250ms

[Install]
WantedBy=multi-user.target
