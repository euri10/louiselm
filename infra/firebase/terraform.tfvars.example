# Project IDs are fixed to louiselm-state and louiselm; the state bucket is fixed to louiselm-tfstate.
# Copy this file to terraform.tfvars outside version control and fill with operator-owned values.
billing_account_id            = "000000-000000-000000"
# org_id                      = "000000000000"
# folder_id                   = "000000000000"
android_package_name          = "dev.louiselm.capture"
android_sha1_fingerprint      = "0000000000000000000000000000000000000000"
android_sha256_fingerprints   = []
# Optional side-by-side QA app. Use its actual signing SHA-1; keep normal inputs unchanged.
# android_qa_sha1_fingerprint = "0000000000000000000000000000000000000000"
gitlab_workload_identity_pool_id     = "gitlab"
gitlab_workload_identity_provider_id = "louiselm"
