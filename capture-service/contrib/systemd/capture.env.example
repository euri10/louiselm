# Required only for automatic cloud transcription. API billing is separate from
# ChatGPT, Codex, and Claude subscriptions.
OPENAI_API_KEY=
LOUISELM_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Required for expiry reaping of cold-Parked workflow claims.
LOUISELM_BEADS_WORKSPACE=/absolute/path/to/louiselm
