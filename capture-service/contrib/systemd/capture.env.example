# Explicit service opt-ins; omit or set false to leave a capability disabled.
# Choose only what you want. Credentials and installed tools never enable it.
LOUISELM_ATTENTION_ENABLED=false
LOUISELM_RUNS_ENABLED=false
LOUISELM_RECEIVER_ENABLED=false
LOUISELM_TRANSCRIPTION_ENABLED=false
LOUISELM_PUSH_ENABLED=false

# Required only with LOUISELM_TRANSCRIPTION_ENABLED=true. API billing is separate from
# ChatGPT, Codex, and Claude subscriptions.
OPENAI_API_KEY=
LOUISELM_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# LOUISELM_PUSH_ENABLED=true requires Attention and this credential path.
# External service-account JSON file, readable only by its owner.
GOOGLE_APPLICATION_CREDENTIALS=
# Required with LOUISELM_RUNS_ENABLED=true for expiry reaping of workflow claims.
LOUISELM_BEADS_WORKSPACE=/absolute/path/to/louiselm
LOUISELM_REAL_BR=/absolute/path/to/br
